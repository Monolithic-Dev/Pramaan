# Copy to .env and fill in. This is everything you need to run JanSetu locally.
# Running locally uses the Firebase EMULATORS (see docs/LOCAL_DEVELOPMENT.md), so no Firebase
# service account or cloud credentials are needed.

# Free key from https://aistudio.google.com/apikey  (used for understanding reports, translation, the co-pilot)
GEMINI_API_KEY=

# Any non-empty value works against the emulators. Only a real deployment needs the real web API key.
FIREBASE_WEB_API_KEY=fake-emulator-key
FIREBASE_PROJECT_ID=pramaan-a0c00

# Deployment only (never needed locally): a service-account JSON, raw or base64, instead of a file path.
# FIREBASE_SERVICE_ACCOUNT_JSON=
