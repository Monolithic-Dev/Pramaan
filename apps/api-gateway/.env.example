# Copy to .env.local (gitignored) for local dev. See docs/phases/phase-3-manual-checklist.md
# for how to get real values for each of these.

# --- Required for anything that touches real Firebase/GCP ---

# Firebase/GCP project id. Used by firebase-admin (Firestore + Auth) and the
# Identity Toolkit REST calls in src/lib/identityToolkit.ts.
FIREBASE_PROJECT_ID=

# Firebase Web API key (console -> Project settings -> General -> Web API Key).
# Used to call the Identity Toolkit REST API server-side for phone OTP.
FIREBASE_WEB_API_KEY=

# Application Default Credentials for firebase-admin / @google-cloud/pubsub.
# Locally: run `gcloud auth application-default login` instead of setting this.
# In CI/Cloud Run: not needed — the runtime service account is used automatically.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Optional, has a working default ---

# Pub/Sub topic that raw submissions are published to (infra/gcp/setup.sh
# creates this). Defaults to "raw-submissions" if unset.
PUBSUB_RAW_SUBMISSIONS_TOPIC=raw-submissions

# Shared-secret placeholder for verifying inbound WhatsApp/SMS webhooks
# (X-Webhook-Secret header). Leave unset for local dev/tests — signature
# checking is skipped when this is empty. Replace with real Twilio/Gupshup
# HMAC verification once a provider sandbox account exists.
WEBHOOK_SHARED_SECRET=

# HTTP port the server listens on.
PORT=8080

# GCP project for BigQuery reference-data lookups and the Gemini agent
# (Vertex AI). Defaults to FIREBASE_PROJECT_ID if unset.
GCP_PROJECT_ID=
VERTEX_LOCATION=asia-south1
GEMINI_AGENT_MODEL=gemini-3.6-flash

# Demo-day rate-limit exemption (docs/phases/phase-8-fraud-impact-crossborder.md
# §8.1) — comma-separated CIDRs, e.g. the venue WiFi's public IP as a /32.
# Leave unset outside of demo day.
RATE_LIMIT_ALLOWLIST_CIDRS=

# Optional: use the public Gemini API instead of Vertex (local dev)
GEMINI_API_KEY=
# Cloud Storage bucket for citizen photo/audio uploads
MEDIA_BUCKET=

# --- Free (no GCP billing) deployment, see docs/FREE_DEPLOYMENT_GUIDE.md ---
# FIREBASE_SERVICE_ACCOUNT_JSON=   (raw or base64 service-account JSON)
# REFERENCE_BACKEND=firestore      (default; "bigquery" on GCP)
# WORKER_URL= / WORKER_SHARED_SECRET=  (HTTP hand-off to the worker instead of Pub/Sub)
# CORS_ORIGINS=https://your-web-domain
