# Copy to .env.local (gitignored) for local dev.

# --- Required for anything that touches real Vertex AI/Firestore ---

# GCP project id. Used by firebase-admin (Firestore) and Vertex AI (Gemini +
# embeddings) via @google/genai's { vertexai: true } mode.
GCP_PROJECT_ID=

# Vertex AI region for Gemini/embedding calls.
VERTEX_LOCATION=asia-south1

# Application Default Credentials — same as apps/api-gateway. Locally, run
# `gcloud auth application-default login` instead of setting this.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Optional, has a working default ---

# Gemini model for structured-output categorization (docs/AI_PIPELINE.md Stage 2).
GEMINI_CATEGORIZATION_MODEL=gemini-2.0-flash

# Vertex AI embedding model (docs/AI_PIPELINE.md Stage 3). Pinned — changing
# this mid-build invalidates every stored embedding.
VERTEX_EMBEDDING_MODEL=text-embedding-005

# Dedup cosine-similarity merge threshold — see docs/DEDUP-TUNING.md for how
# this was picked (currently a placeholder run, not the real 120-pair sweep).
DEDUP_SIMILARITY_THRESHOLD=0.82

# HTTP port the Pub/Sub push endpoint listens on.
PORT=8081
