rules_version = '2';

// Deny-by-default: citizens and officers never talk to Firestore directly.
// All reads/writes go through api-gateway / worker-ai-pipeline using
// service-account credentials (which bypass these client-facing rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
